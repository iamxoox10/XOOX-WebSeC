#!/bin/bash

clear

echo "██╗  ██╗ ██████╗  ██████╗ ██╗  ██╗"
echo "╚██╗██╔╝██╔═══██╗██╔═══██╗╚██╗██╔╝"
echo " ╚███╔╝ ██║   ██║██║   ██║ ╚███╔╝ "
echo " ██╔██╗ ██║   ██║██║   ██║ ██╔██╗ "
echo "██╔╝ ██╗╚██████╔╝╚██████╔╝██╔╝ ██╗"
echo "╚═╝  ╚═╝ ╚═════╝  ╚═════╝ ╚═╝  ╚═╝"
echo
echo "          XOOX WebSeC"
echo "   Made by Pakistani OrakxAi Anonymous"
echo
echo "----------------------------------------"
echo

BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
MODULE_DIR="$BASE_DIR/modules"

pause() {
    echo
    read -r -p "Press Enter to continue..."
}

target_prompt() {
    read -r -p "Target URL/domain: " TARGET

    if [ -z "$TARGET" ]; then
        echo "[!] Target cannot be empty."
        return 1
    fi

    export TARGET
    return 0
}

while true; do

    echo "[1] Recon"
    echo "[2] HTTP Security"
    echo "[3] TLS / SSL"
    echo "[4] Port & Service Check"
    echo "[5] SQL Injection Detection"
    echo "[6] Full Security Scan"
    echo "[0] Exit"
    echo
    read -r -p "XOOX > " CHOICE

    case "$CHOICE" in

        1)
            clear
            echo "[*] Recon"
            echo
            if target_prompt; then
                bash "$MODULE_DIR/recon.sh" "$TARGET"
            fi
            pause
            clear
            ;;

        2)
            clear
            echo "[*] HTTP Security Audit"
            echo
            if target_prompt; then
                bash "$MODULE_DIR/headers.sh" "$TARGET"
            fi
            pause
            clear
            ;;

        3)
            clear
            echo "[*] TLS / SSL Audit"
            echo
            if target_prompt; then
                bash "$MODULE_DIR/tls.sh" "$TARGET"
            fi
            pause
            clear
            ;;

        4)
            clear
            echo "[*] Port / Service Check"
            echo

            if target_prompt; then
                if command -v nmap >/dev/null 2>&1; then
                    nmap -sT -sV --top-ports 100 "$TARGET"
                else
                    echo "[!] nmap is not installed."
                    echo "[*] Run: apk add nmap"
                fi
            fi

            pause
            clear
            ;;

        5)
            clear
            echo "[*] SQL Injection Detection"
            echo

            if target_prompt; then
                bash "$MODULE_DIR/sqli.sh" "$TARGET"
            fi

            pause
            clear
            ;;

        6)
            clear
            echo "[*] Full Safe Web Security Scan"
            echo

            if target_prompt; then

                echo
                echo "========== RECON =========="
                bash "$MODULE_DIR/recon.sh" "$TARGET"

                echo
                echo "====== HTTP SECURITY ======"
                bash "$MODULE_DIR/headers.sh" "$TARGET"

                echo
                echo "======== TLS / SSL ========"
                bash "$MODULE_DIR/tls.sh" "$TARGET"

                echo
                echo "========= SQLi TEST ======="
                bash "$MODULE_DIR/sqli.sh" "$TARGET"

            fi

            pause
            clear
            ;;

        0)
            echo
            echo "XOOX WebSeC closed."
            exit 0
            ;;

        *)
            echo
            echo "[!] Invalid option."
            sleep 1
            clear
            ;;

    esac

done
