#!/bin/bash

BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
MODULE_DIR="$BASE_DIR/modules"

source "$MODULE_DIR/banner.sh"

show_banner

pause() {
    echo
    read -r -p "Press Enter to continue..."
}

get_target() {
    read -r -p "Target URL/domain: " TARGET

    if [ -z "$TARGET" ]; then
        echo "[!] Target cannot be empty."
        return 1
    fi

    export TARGET
    return 0
}

while true; do

    echo "[1] Recon"
    echo "[2] HTTP Security"
    echo "[3] TLS / SSL"
    echo "[4] Port & Service Check"
    echo "[5] SQL Injection Detection"
    echo "[6] Full Security Scan"
    echo "[0] Exit"
    echo

    read -r -p "XOOX > " CHOICE

    case "$CHOICE" in

        1)
            clear
            show_banner
            echo "[*] Recon"
            echo

            if get_target; then
                bash "$MODULE_DIR/recon.sh" "$TARGET"
            fi

            pause
            clear
            show_banner
            ;;

        2)
            clear
            show_banner
            echo "[*] HTTP Security Audit"
            echo

            if get_target; then
                bash "$MODULE_DIR/headers.sh" "$TARGET"
            fi

            pause
            clear
            show_banner
            ;;

        3)
            clear
            show_banner
            echo "[*] TLS / SSL Audit"
            echo

            if get_target; then
                bash "$MODULE_DIR/tls.sh" "$TARGET"
            fi

            pause
            clear
            show_banner
            ;;

        4)
            clear
            show_banner
            echo "[*] Port / Service Check"
            echo

            if get_target; then
                HOST="$TARGET"

                HOST="${HOST#http://}"
                HOST="${HOST#https://}"
                HOST="${HOST%%/*}"
                HOST="${HOST%%:*}"

                if command -v nmap >/dev/null 2>&1; then
                    nmap -sT -sV --top-ports 100 "$HOST"
                else
                    echo "[!] nmap is not installed."
                    echo "[*] Run: apk add nmap"
                fi
            fi

            pause
            clear
            show_banner
            ;;

        5)
            clear
            show_banner
            echo "[*] SQL Injection Detection"
            echo

            if get_target; then
                bash "$MODULE_DIR/sqli.sh" "$TARGET"
            fi

            pause
            clear
            show_banner
            ;;

        6)
            clear
            show_banner
            echo "[*] Full Security Scan"
            echo

            if get_target; then

                echo
                echo "========== RECON =========="
                bash "$MODULE_DIR/recon.sh" "$TARGET"

                echo
                echo "====== HTTP SECURITY ======"
                bash "$MODULE_DIR/headers.sh" "$TARGET"

                echo
                echo "======== TLS / SSL ========"
                bash "$MODULE_DIR/tls.sh" "$TARGET"

                echo
                echo "========= SQLi TEST ======="
                bash "$MODULE_DIR/sqli.sh" "$TARGET"

                echo
                echo "[+] Scan completed."
            fi

            pause
            clear
            show_banner
            ;;

        0)
            clear
            echo "XOOX WebSeC closed."
            exit 0
            ;;

        *)
            echo "[!] Invalid option."
            sleep 1
            clear
            show_banner
            ;;

    esac

done
